{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Integrations": {
    "N8n": {
      "ApiKey": ""
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": ""
  },
  "EmailSettings": {
    "Password": "",
    "FromEmail": "",
    "ReplyTo": "",
    "FromName": "",
    "FrontendBaseUrl": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "VerifyServiceSid": "",
    "PhoneNumber": ""
  },
  "TaxVerification": {
    "Provider": "Lookuptax",
    "Lookuptax": {
      "BaseUrl": "",
      "ApiKey": "",
      "TimeoutInSeconds": ""
    }
  },
  "ClamAV": {
    "Host": "",
    "Port": ""
  },
  "Paymob": {
    "BaseUrl": "",
    "APIKey": "",
    "SecretKey": "",
    "PublicKey": "",
    "HMAC": "",
    "CallbackUrl": "",
    "RedirectUrl": "",
    "UnifiedCheckoutUrl": "",
    "PaymentMethod": ""
  },
  "CORS": {
    "CorsPolicy": "FrontendCors",
    "AllowedOrigins": [ "", "", "", "", "" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}